      </DebugOpt>
      <TargetDriverDllRegistry>
        <SetRegEntry>
          <Number>0</Number>
          <Key>CMSIS_AGDI_V8M</Key>
          <Name>-O206 -S0 -C0 -P00000000 -N00("ARM CoreSight SW-DP") -D00(1BE12AEB) -L00(0) -TO65554 -TC10000000 -TT10000000 -TP20 -TDS8007 -TDT0 -TDC1F -TIEFFFFFFFF -TIP8 -FO15 -FD20010000 -FC10000 -FN1 -FF0ACM32P4_SPI_FLASH.FLM -FS08002000 -FL0FE000 -FP0($$Device:ACM32P4XX$Flash\ACM32P4_SPI_FLASH.FLM)</Name>
        </SetRegEntry>
        <SetRegEntry>
          <Number>0</Number>
          <Key>UL2V8M</Key>
          <Name>UL2V8M(-S0 -C0 -P0 -FD20010000 -FC10000 -FN1 -FF0ACM32P4_SPI_FLASH -FS08002000 -FL0FE000 -FP0($$Device:ACM32P4XX$Flash\ACM32P4_SPI_FLASH.FLM))</Name>
        </SetRegEntry>
      </TargetDriverDllRegistry>
