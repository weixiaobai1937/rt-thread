menu "Hardware Drivers Config"

choice
    prompt "select chip type"
    default SOC_ACM32P40N128CCT

    config SOC_ACM32P40N128CCT
    bool "SOC_ACM32P40N128CCT"
    select RT_USING_COMPONENTS_INIT
    select RT_USING_USER_MAIN
    help
        ACM32P40N128CCT, Cortex-M33 core, 128KB SRAM, 1MB Flash

endchoice

menu "ACM32P4xx Chip Configuration"
    depends on SOC_ACM32P40N128CCT

    config SOC_SRAM_START_ADDR
        hex "sram start address"
        default 0x20000000

    config SOC_SRAM_SIZE
        hex "sram size(KBytes)"
        default 0x80

    config SOC_FLASH_START_ADDR
        hex "Flash Start Address"
        default 0x08000000

    config SOC_FLASH_SIZE
        hex "Flash Size(KBytes)"
        default 0x400

endmenu

menu "ACM32P4xx Onboard Peripheral Drivers"

    config BSP_USING_UART1
        bool "Enable UART1"
        select RT_USING_SERIAL_V2
        default y
        help
          Pin group and DMA map selectable below (ACM32P4xx AF table).

    choice
        prompt "UART1 pin group"
        depends on BSP_USING_UART1
        default BSP_UART1_PINS_PA9
        help
          TX/RX mux groups from the AF table.

        config BSP_UART1_PINS_PA9
            bool "PA9(TX)/PA10(RX) AF1 (default, console)"
        config BSP_UART1_PINS_PB6
            bool "PB6(TX)/PB7(RX) AF1"
    endchoice

    config BSP_USING_UART1_DMA
        bool "Enable UART1 DMA"
        depends on BSP_USING_UART1
        default n
        help
          DMA unit/channel: pick a preset map or Custom.
          WARNING: unit+channel must be unique across UART/SPI DMA users.
          Compile-time check in dma_channel_check.h.

    choice
        prompt "UART1 DMA channel map"
        depends on BSP_USING_UART1_DMA
        default BSP_UART1_DMA_MAP_DEFAULT

        config BSP_UART1_DMA_MAP_DEFAULT
            bool "TX=DMA1_CH1, RX=DMA1_CH2 (default)"
        config BSP_UART1_DMA_MAP_DMA2
            bool "TX=DMA2_CH1, RX=DMA2_CH2"
        config BSP_UART1_DMA_MAP_CUSTOM
            bool "Custom TX/RX unit + channel"
    endchoice

    config BSP_UART1_TX_DMA_UNIT
        int "UART1 TX DMA unit (1=DMA1, 2=DMA2)" if BSP_UART1_DMA_MAP_CUSTOM
        depends on BSP_USING_UART1_DMA
        range 1 2
        default 1 if BSP_UART1_DMA_MAP_DEFAULT
        default 2 if BSP_UART1_DMA_MAP_DMA2
        default 1

    config BSP_UART1_TX_DMA_CH
        int "UART1 TX DMA channel (0~3)" if BSP_UART1_DMA_MAP_CUSTOM
        depends on BSP_USING_UART1_DMA
        range 0 3
        default 1 if BSP_UART1_DMA_MAP_DEFAULT
        default 1 if BSP_UART1_DMA_MAP_DMA2
        default 1

    config BSP_UART1_RX_DMA_UNIT
        int "UART1 RX DMA unit (1=DMA1, 2=DMA2)" if BSP_UART1_DMA_MAP_CUSTOM
        depends on BSP_USING_UART1_DMA
        range 1 2
        default 1 if BSP_UART1_DMA_MAP_DEFAULT
        default 2 if BSP_UART1_DMA_MAP_DMA2
        default 1

    config BSP_UART1_RX_DMA_CH
        int "UART1 RX DMA channel (0~3)" if BSP_UART1_DMA_MAP_CUSTOM
        depends on BSP_USING_UART1_DMA
        range 0 3
        default 2 if BSP_UART1_DMA_MAP_DEFAULT
        default 2 if BSP_UART1_DMA_MAP_DMA2
        default 2

    config BSP_USING_UART2
        bool "Enable UART2"
        select RT_USING_SERIAL_V2
        default n
        help
          Pin group and DMA map selectable below.

    choice
        prompt "UART2 pin group"
        depends on BSP_USING_UART2
        default BSP_UART2_PINS_PD5

        config BSP_UART2_PINS_PD5
            bool "PD5(TX)/PD6(RX) AF3 (default)"
        config BSP_UART2_PINS_PA2
            bool "PA2(TX)/PA3(RX) AF1"
            help
              Conflicts with default LPUART1 PA2/PA3 if both enabled.
    endchoice

    config BSP_USING_UART2_DMA
        bool "Enable UART2 DMA"
        depends on BSP_USING_UART2
        default n
        help
          DMA unit/channel: pick a preset map or Custom.
          WARNING: unit+channel must be unique across UART/SPI DMA users.

    choice
        prompt "UART2 DMA channel map"
        depends on BSP_USING_UART2_DMA
        default BSP_UART2_DMA_MAP_DEFAULT

        config BSP_UART2_DMA_MAP_DEFAULT
            bool "TX=DMA1_CH3, RX=DMA2_CH0 (default)"
        config BSP_UART2_DMA_MAP_DMA1
            bool "TX=DMA1_CH0, RX=DMA1_CH1"
        config BSP_UART2_DMA_MAP_CUSTOM
            bool "Custom TX/RX unit + channel"
    endchoice

    config BSP_UART2_TX_DMA_UNIT
        int "UART2 TX DMA unit (1=DMA1, 2=DMA2)" if BSP_UART2_DMA_MAP_CUSTOM
        depends on BSP_USING_UART2_DMA
        range 1 2
        default 1 if BSP_UART2_DMA_MAP_DEFAULT
        default 1 if BSP_UART2_DMA_MAP_DMA1
        default 1

    config BSP_UART2_TX_DMA_CH
        int "UART2 TX DMA channel (0~3)" if BSP_UART2_DMA_MAP_CUSTOM
        depends on BSP_USING_UART2_DMA
        range 0 3
        default 3 if BSP_UART2_DMA_MAP_DEFAULT
        default 0 if BSP_UART2_DMA_MAP_DMA1
        default 3

    config BSP_UART2_RX_DMA_UNIT
        int "UART2 RX DMA unit (1=DMA1, 2=DMA2)" if BSP_UART2_DMA_MAP_CUSTOM
        depends on BSP_USING_UART2_DMA
        range 1 2
        default 2 if BSP_UART2_DMA_MAP_DEFAULT
        default 1 if BSP_UART2_DMA_MAP_DMA1
        default 2

    config BSP_UART2_RX_DMA_CH
        int "UART2 RX DMA channel (0~3)" if BSP_UART2_DMA_MAP_CUSTOM
        depends on BSP_USING_UART2_DMA
        range 0 3
        default 0 if BSP_UART2_DMA_MAP_DEFAULT
        default 1 if BSP_UART2_DMA_MAP_DMA1
        default 0

    config BSP_USING_UART3
        bool "Enable UART3"
        select RT_USING_SERIAL_V2
        default n

    choice
        prompt "UART3 pin group"
        depends on BSP_USING_UART3
        default BSP_UART3_PINS_PB10

        config BSP_UART3_PINS_PB10
            bool "PB10(TX)/PB11(RX) AF1 (default)"
            help
