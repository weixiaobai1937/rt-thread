            help
              Window/system WDT clocked from APB1. Device name "wdt".

        config BSP_USING_IWDT
            bool "Enable Independent Watchdog (IWDT)"
            select RT_USING_WDT
            default n
            help
              Independent WDT clocked from RC32K. Device name "iwdt".
    endmenu

    menu "Hardware FDCAN"
        config BSP_USING_FDCAN1
            bool "Enable FDCAN1"
            select RT_USING_CAN
            default n

        choice
            prompt "FDCAN1 TX pin"
            depends on BSP_USING_FDCAN1
            default BSP_FDCAN1_TX_PD1
            config BSP_FDCAN1_TX_PD1
                bool "PD1 AF4 (default)"
            config BSP_FDCAN1_TX_PB9
                bool "PB9 AF4"
            config BSP_FDCAN1_TX_PA12
                bool "PA12 AF4 (USB_DP)"
        endchoice

        choice
            prompt "FDCAN1 RX pin"
            depends on BSP_USING_FDCAN1
            default BSP_FDCAN1_RX_PD0
            config BSP_FDCAN1_RX_PD0
                bool "PD0 AF4 (default)"
            config BSP_FDCAN1_RX_PB8
                bool "PB8 AF4"
            config BSP_FDCAN1_RX_PA11
                bool "PA11 AF4 (USB_DM)"
        endchoice

        config BSP_USING_FDCAN2
            bool "Enable FDCAN2"
            select RT_USING_CAN
            default n

        choice
            prompt "FDCAN2 TX pin"
            depends on BSP_USING_FDCAN2
