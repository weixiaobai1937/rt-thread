                bool "PE5 AF1 (default)"
            config BSP_FDCAN2_RX_PD11
                bool "PD11 AF1"
        endchoice
    endmenu

    config BSP_USING_HWCRYPTO
        bool "Enable HWRNG (True Random Number Generator)"
        select RT_USING_HWCRYPTO
        select RT_USING_HWCRYPTO_RNG
        default n
        help
            Enable hardware random number generator using HRNG peripheral.
            Device registered as "hwcrypto" via rt_hwcrypto_register.

    config BSP_USING_I2S1
        bool "Enable I2S1 (Audio output)"
        select RT_USING_AUDIO
        depends on !BSP_USING_SDMMC1
        default n
        help
          Default pins avoid DAC (PA4/5) and SDMMC CLK (PC12).
          Mutually exclusive with SDMMC1 default pinout (PC12).

    choice
        prompt "I2S1 WS pin"
        depends on BSP_USING_I2S1
        default BSP_I2S1_WS_PA15
        config BSP_I2S1_WS_PA15
            bool "PA15 AF7 (default, avoids DAC PA4)"
        config BSP_I2S1_WS_PA4
            bool "PA4 AF7 (conflicts with DAC1_OUT1)"
    endchoice

    choice
        prompt "I2S1 CK pin"
        depends on BSP_USING_I2S1
        default BSP_I2S1_CK_PB3
        config BSP_I2S1_CK_PB3
            bool "PB3 AF7 (default, avoids DAC PA5)"
        config BSP_I2S1_CK_PA5
            bool "PA5 AF7 (conflicts with DAC1_OUT2)"
        config BSP_I2S1_CK_PC10
            bool "PC10 AF7"
    endchoice

    choice
        prompt "I2S1 SDI pin"
        depends on BSP_USING_I2S1
        default BSP_I2S1_SDI_PB4
        config BSP_I2S1_SDI_PB4
            bool "PB4 AF7 (default)"
        config BSP_I2S1_SDI_PA6
            bool "PA6 AF7"
        config BSP_I2S1_SDI_PC11
            bool "PC11 AF7"
    endchoice

    choice
        prompt "I2S1 SDO pin"
        depends on BSP_USING_I2S1
        default BSP_I2S1_SDO_PB5
        config BSP_I2S1_SDO_PB5
            bool "PB5 AF7 (default, avoids SDMMC PC12)"
        config BSP_I2S1_SDO_PD7
            bool "PD7 AF7"
        config BSP_I2S1_SDO_PC12
            bool "PC12 AF7 (conflicts with SDMMC CLK)"
    endchoice

    choice
        prompt "I2S1 MCK pin"
        depends on BSP_USING_I2S1
        default BSP_I2S1_MCK_PC7
        config BSP_I2S1_MCK_PC7
            bool "PC7 AF7 (default, avoids ETH PC4)"
        config BSP_I2S1_MCK_PC4
            bool "PC4 AF7 (conflicts with ETH RMII RXD0)"
    endchoice

    config BSP_USING_ETH
        bool "Enable Ethernet (LAN8720A, RMII)"
        select RT_USING_ETH
        select RT_USING_LWIP
        select RT_USING_MEMHEAP
        default n
        help
            Enable ETH driver for ACM32P4xx-Nucleo (RMII + OSPI PSRAM DMA buffers).
            IP mode: see "Use static IP" below (default static). Enable
            RT_LWIP_DHCP in the Network menu if you need DHCP instead.
            PHY: LAN8720A, Interface: RMII, Pins: all AF6.
            Enables lwIP protocol stack with DHCP.

    config BSP_ETH_PHY_RST_PIN
        int "ETH PHY nRST pin index"
        depends on BSP_USING_ETH
        range 0 127
        default 30
        help
          RT-Thread pin index for LAN8720A nRST (any GPIO).
          Formula: PXn = port*16 + n  (PA0=0, PB0=16, PC0=32, PD0=48, PE0=64).
          Common: PB14=30, PC0=32. PB14 conflicts with SPI2 MISO if SPI2 on.

    config BSP_USING_IPERF
        bool "Enable iperf MSH command (lwIP lwiperf, TCP port 5001)"
        depends on BSP_USING_ETH
        default n
        help
          Uses lwIP official lwiperf raw-API app (same as ACM32 HAL LwIP_iperf demo).
          board:  iperf -s
          host:   iperf -c 192.168.16.50 -p 5001 -t 10  (iperf2, not iperf3)

    config LWIP_SUPPORT_CUSTOM_PBUF
        int
        default 1 if BSP_USING_ETH

    config BSP_ETH_STATIC_IP
        bool "Use static IP address instead of DHCP"
        depends on BSP_USING_ETH
        default y
        help
            Set a static IP address at startup instead of relying on DHCP.
            Useful when no DHCP server is available on the network.

