        default 2 if BSP_SPI3_DMA_MAP_DMA1
        default 0

    config BSP_SPI3_RX_DMA_UNIT
        int "SPI3 RX DMA unit (1=DMA1, 2=DMA2)" if BSP_SPI3_DMA_MAP_CUSTOM
        depends on BSP_USING_SPI3_DMA
        range 1 2
        default 2 if BSP_SPI3_DMA_MAP_DEFAULT
        default 1 if BSP_SPI3_DMA_MAP_DMA1
        default 2

    config BSP_SPI3_RX_DMA_CH
        int "SPI3 RX DMA channel (0~3)" if BSP_SPI3_DMA_MAP_CUSTOM
        depends on BSP_USING_SPI3_DMA
        range 0 3
        default 2 if BSP_SPI3_DMA_MAP_DEFAULT
        default 3 if BSP_SPI3_DMA_MAP_DMA1
        default 2

    config BSP_USING_SPI4
        bool "Enable SPI4"
        select RT_USING_SPI
        select RT_USING_PIN
        default n
        help
          Pin group selectable below. PE group avoids SPI1 PE10-13.

    choice
        prompt "SPI4 pin group"
        depends on BSP_USING_SPI4
        default BSP_SPI4_PINS_PE
        help
          Complete SCK/MOSI/MISO mux groups from the AF table.

        config BSP_SPI4_PINS_PE
            bool "PE2/PE6/PE5 AF4, soft CS PE4"
            help
              SCK=PE2 MOSI=PE6 MISO=PE5 (AF4). Soft CS PE4.

        config BSP_SPI4_PINS_PB
            bool "PB2/PB1/PB6, soft CS PE4"
            help
              SCK=PB2(AF1) MOSI=PB1(AF0) MISO=PB6(AF3). Soft CS PE4.
    endchoice

    config BSP_SPI4_CS_PIN
        int "SPI4 soft CS pin index (A=0..15, B=16..31, C=32.., D=48.., E=64..)"
        depends on BSP_USING_SPI4
        range -1 127
        default 68 if BSP_SPI4_PINS_PE
        default 68 if BSP_SPI4_PINS_PB
        default 68
        help
          Soft CS GPIO index. -1 means no CS pin.

    config BSP_USING_SPI4_DMA
        bool "Enable SPI4 DMA"
        depends on BSP_USING_SPI4
        default n
        help
          Same policy as SPI1 DMA: half-duplex TX/RX >= 32 bytes.
          DMA unit/channel: pick a preset map or Custom below.
          WARNING: unit+channel must be unique across all UART/SPI DMA users.
          Compile-time check in dma_channel_check.h.

    choice
        prompt "SPI4 DMA channel map"
        depends on BSP_USING_SPI4_DMA
        default BSP_SPI4_DMA_MAP_DEFAULT
        help
          DMA1/DMA2 each have CH0~CH3 only.

        config BSP_SPI4_DMA_MAP_DEFAULT
            bool "TX=DMA1_CH2, RX=DMA1_CH3 (default)"

        config BSP_SPI4_DMA_MAP_DMA2
            bool "TX=DMA2_CH2, RX=DMA2_CH0"
            help
              Alternate on DMA2. Check conflicts with SPI1/SPI3/UART2 defaults.

        config BSP_SPI4_DMA_MAP_CUSTOM
            bool "Custom TX/RX unit + channel"
    endchoice

    config BSP_SPI4_TX_DMA_UNIT
        int "SPI4 TX DMA unit (1=DMA1, 2=DMA2)" if BSP_SPI4_DMA_MAP_CUSTOM
        depends on BSP_USING_SPI4_DMA
        range 1 2
        default 1 if BSP_SPI4_DMA_MAP_DEFAULT
        default 2 if BSP_SPI4_DMA_MAP_DMA2
        default 1

    config BSP_SPI4_TX_DMA_CH
        int "SPI4 TX DMA channel (0~3)" if BSP_SPI4_DMA_MAP_CUSTOM
        depends on BSP_USING_SPI4_DMA
        range 0 3
        default 2 if BSP_SPI4_DMA_MAP_DEFAULT
        default 2 if BSP_SPI4_DMA_MAP_DMA2
        default 2

    config BSP_SPI4_RX_DMA_UNIT
        int "SPI4 RX DMA unit (1=DMA1, 2=DMA2)" if BSP_SPI4_DMA_MAP_CUSTOM
        depends on BSP_USING_SPI4_DMA
        range 1 2
        default 1 if BSP_SPI4_DMA_MAP_DEFAULT
        default 2 if BSP_SPI4_DMA_MAP_DMA2
        default 1

    config BSP_SPI4_RX_DMA_CH
        int "SPI4 RX DMA channel (0~3)" if BSP_SPI4_DMA_MAP_CUSTOM
        depends on BSP_USING_SPI4_DMA
        range 0 3
        default 3 if BSP_SPI4_DMA_MAP_DEFAULT
        default 0 if BSP_SPI4_DMA_MAP_DMA2
        default 3

    config BSP_USING_GPIO1
        bool "Enable GPIO1"
        select RT_USING_PIN
        default y

    config BSP_USING_ETH
        bool "Enable Ethernet (LAN8720A, RMII)"
        select RT_USING_ETH
        select RT_USING_LWIP
        select RT_LWIP_DHCP
        default n
        help
            Enable ETH driver for ACM32P4xx-Nucleo.
            PHY: LAN8720A, Interface: RMII, Pins: all AF6.
            Enables lwIP protocol stack with DHCP.

    config BSP_ETH_PHY_RST_PIN
        int "ETH PHY nRST pin index"
        depends on BSP_USING_ETH
        range 0 127
        default 30
        help
          RT-Thread pin index for LAN8720A nRST (any GPIO).
          Formula: PXn = port*16 + n  (PA0=0, PB0=16, PC0=32, PD0=48, PE0=64).
          Common: PB14=30, PC0=32. PB14 conflicts with SPI2 MISO if SPI2 on.

    config BSP_USING_IPERF
        bool "Enable iperf MSH command (lwIP lwiperf, TCP port 5001)"
        depends on BSP_USING_ETH
        default n
        help
          Uses lwIP official lwiperf raw-API app (same as ACM32 HAL LwIP_iperf demo).
          board:  iperf -s
          host:   iperf -c 192.168.16.50 -p 5001 -t 10  (iperf2, not iperf3)

    config LWIP_SUPPORT_CUSTOM_PBUF
        int
        default 1 if BSP_USING_ETH

    config BSP_ETH_STATIC_IP
        bool "Use static IP address instead of DHCP"
        depends on BSP_USING_ETH
        default y
        help
            Set a static IP address at startup instead of relying on DHCP.
            Useful when no DHCP server is available on the network.

    config BSP_ETH_STATIC_IP0
        int "Static IP byte 0"
        depends on BSP_ETH_STATIC_IP
        default 192

    config BSP_ETH_STATIC_IP1
