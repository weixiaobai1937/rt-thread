    config BSP_USING_SDMMC1
        bool "Enable SDMMC1 (SD card via SDIO)"
        select RT_USING_SDIO
        depends on !BSP_USING_I2S1
        default n
        help
            Enable SD/MMC driver for SD card slot.
            Pins: PC8=DAT0, PC9=DAT1, PC10=DAT2, PC11=DAT3, PC12=CLK, PD2=CMD (all AF12).
            Mutually exclusive with I2S1 (default I2S SDO also wants PC12).
            Uses HAL SDMMC FIFO mode (polling) for D-Cache safety.

