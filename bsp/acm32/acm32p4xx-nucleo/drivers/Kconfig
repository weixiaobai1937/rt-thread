    config BSP_USING_SPI1
        bool "Enable SPI1"
        select RT_USING_SPI
        select RT_USING_PIN
        default n
        help
          Pin group selectable below (SCK/MOSI/MISO + default soft CS).
          From ACM32P4xx GPIO AF table; CS is soft GPIO by default.

    choice
        prompt "SPI1 pin group"
        depends on BSP_USING_SPI1
        default BSP_SPI1_PINS_PE
        help
          Complete SCK/MOSI/MISO mux groups from the AF table.

        config BSP_SPI1_PINS_PE
            bool "PE12/PE11/PE10 AF3, soft CS PE13"
            help
              SCK=PE12 MOSI=PE11 MISO=PE10 (AF3). Default soft CS PE13.

        config BSP_SPI1_PINS_PA
            bool "PA5/PA7/PA6 AF0, soft CS PA4"
            help
              SCK=PA5 MOSI=PA7 MISO=PA6 (AF0). Default soft CS PA4.

        config BSP_SPI1_PINS_PB
            bool "PB3/PB5/PB4, soft CS PA15"
            help
              SCK=PB3(AF4) MOSI=PB5(AF0) MISO=PB4(AF4). Soft CS PA15.
    endchoice

    config BSP_SPI1_CS_PIN
        int "SPI1 soft CS pin index (A=0..15, B=16..31, C=32.., D=48.., E=64..)"
        depends on BSP_USING_SPI1
        range -1 127
        default 77 if BSP_SPI1_PINS_PE
        default 4 if BSP_SPI1_PINS_PA
        default 15 if BSP_SPI1_PINS_PB
        default 77
        help
          Soft CS GPIO index for rt_hw_spi_device_attach / SPI1_DEFAULT_CS_PIN_INDEX.
          Set -1 for no hardware CS pin (RT_SPI_NO_CS).

    config BSP_USING_SPI1_DMA
        bool "Enable SPI1 DMA"
        depends on BSP_USING_SPI1
        default n
        help
          Half-duplex TX/RX >= 32 bytes use DMA.
          Full-duplex always polls (HAL has no TransmitReceive_DMA).
          DMA unit/channel: pick a preset map or Custom below.
          WARNING: unit+channel must be unique across all UART/SPI DMA users.
          Compile-time check in dma_channel_check.h.

    choice
        prompt "SPI1 DMA channel map"
        depends on BSP_USING_SPI1_DMA
        default BSP_SPI1_DMA_MAP_DEFAULT
        help
          DMA1/DMA2 each have CH0~CH3 only. Maps set TX/RX unit+channel.
          Choose Custom to edit unit/channel manually.

        config BSP_SPI1_DMA_MAP_DEFAULT
            bool "TX=DMA2_CH1, RX=DMA2_CH3 (default)"
            help
              Recommended default. Avoids UART2 DMA defaults.

        config BSP_SPI1_DMA_MAP_DMA1
            bool "TX=DMA1_CH0, RX=DMA1_CH1"
            help
              Alternate on DMA1. Conflicts SPI2 default map if both use DMA.

        config BSP_SPI1_DMA_MAP_CUSTOM
            bool "Custom TX/RX unit + channel"
            help
              Configure the four int options below.
    endchoice

    config BSP_SPI1_TX_DMA_UNIT
        int "SPI1 TX DMA unit (1=DMA1, 2=DMA2)" if BSP_SPI1_DMA_MAP_CUSTOM
        depends on BSP_USING_SPI1_DMA
        range 1 2
        default 2 if BSP_SPI1_DMA_MAP_DEFAULT
        default 1 if BSP_SPI1_DMA_MAP_DMA1
        default 2

    config BSP_SPI1_TX_DMA_CH
        int "SPI1 TX DMA channel (0~3)" if BSP_SPI1_DMA_MAP_CUSTOM
        depends on BSP_USING_SPI1_DMA
        range 0 3
        default 1 if BSP_SPI1_DMA_MAP_DEFAULT
        default 0 if BSP_SPI1_DMA_MAP_DMA1
        default 1

    config BSP_SPI1_RX_DMA_UNIT
        int "SPI1 RX DMA unit (1=DMA1, 2=DMA2)" if BSP_SPI1_DMA_MAP_CUSTOM
        depends on BSP_USING_SPI1_DMA
        range 1 2
        default 2 if BSP_SPI1_DMA_MAP_DEFAULT
        default 1 if BSP_SPI1_DMA_MAP_DMA1
        default 2

    config BSP_SPI1_RX_DMA_CH
        int "SPI1 RX DMA channel (0~3)" if BSP_SPI1_DMA_MAP_CUSTOM
        depends on BSP_USING_SPI1_DMA
        range 0 3
        default 3 if BSP_SPI1_DMA_MAP_DEFAULT
        default 1 if BSP_SPI1_DMA_MAP_DMA1
        default 3
        help
          Must differ from TX when TX/RX use the same DMA unit.

    config BSP_USING_SPI2
        bool "Enable SPI2"
        select RT_USING_SPI
        select RT_USING_PIN
        default n
        help
          Pin group selectable below. PB13 group conflicts with ETH RMII TXD0/TXD1;
          use PC group when Ethernet is enabled.

    choice
        prompt "SPI2 pin group"
        depends on BSP_USING_SPI2
        default BSP_SPI2_PINS_PB13 if !BSP_USING_ETH
        default BSP_SPI2_PINS_PC if BSP_USING_ETH
        help
          Complete SCK/MOSI/MISO mux groups from the AF table.

        config BSP_SPI2_PINS_PB13
            bool "PB13/PB15/PB14 AF3, soft CS PB12 (conflicts ETH)"
            depends on !BSP_USING_ETH
            help
              SCK=PB13 MOSI=PB15 MISO=PB14 (AF3). Soft CS PB12.
              Conflicts with ETH RMII TXD0/TXD1 on PB12/PB13.

        config BSP_SPI2_PINS_PC
            bool "PC7/PC9/PC8 AF6, soft CS PC6"
            help
              SCK=PC7 MOSI=PC9 MISO=PC8 (AF6). Soft CS PC6.
              Safe to use with Ethernet.

        config BSP_SPI2_PINS_PB10
            bool "PB10/PB15/PB14 AF3, soft CS PB9"
            help
              SCK=PB10 MOSI=PB15 MISO=PB14 (AF3). Soft CS PB9.
              Note: PB14 may conflict with ETH PHY reset if that uses PB14.
    endchoice

    config BSP_SPI2_CS_PIN
        int "SPI2 soft CS pin index (A=0..15, B=16..31, C=32.., D=48.., E=64..)"
        depends on BSP_USING_SPI2
        range -1 127
        default 28 if BSP_SPI2_PINS_PB13
        default 38 if BSP_SPI2_PINS_PC
        default 25 if BSP_SPI2_PINS_PB10
        default 28
        help
          Soft CS GPIO index. -1 means no CS pin.

    config BSP_USING_SPI2_DMA
        bool "Enable SPI2 DMA"
        depends on BSP_USING_SPI2
        default n
        help
          Same policy as SPI1 DMA: half-duplex TX/RX >= 32 bytes.
          DMA unit/channel: pick a preset map or Custom below.
          WARNING: unit+channel must be unique across all UART/SPI DMA users.
          Compile-time check in dma_channel_check.h.

    choice
        prompt "SPI2 DMA channel map"
        depends on BSP_USING_SPI2_DMA
        default BSP_SPI2_DMA_MAP_DEFAULT
        help
