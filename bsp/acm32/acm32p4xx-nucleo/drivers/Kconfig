    config BSP_USING_SPI1_DMA
        bool "Enable SPI1 DMA"
        depends on BSP_USING_SPI1
        default n
        help
          Half-duplex TX/RX >= 32 bytes use DMA.
          Full-duplex always polls (HAL has no TransmitReceive_DMA).
          DMA unit/channel: pick a preset map or Custom below.
          WARNING: unit+channel must be unique across all UART/SPI DMA users.
          Compile-time check in rtconfig.py check_bsp_resources.

    choice
        prompt "SPI1 DMA channel map"
        depends on BSP_USING_SPI1_DMA
        default BSP_SPI1_DMA_MAP_DEFAULT
        help
          DMA1/DMA2 each have CH0~CH3 only. Maps set TX/RX unit+channel.
          Choose Custom to edit unit/channel manually.

        config BSP_SPI1_DMA_MAP_DEFAULT
            bool "TX=DMA2_CH1, RX=DMA2_CH3 (default)"
            help
              Recommended default. Avoids UART2 DMA defaults.

        config BSP_SPI1_DMA_MAP_DMA1
            bool "TX=DMA1_CH0, RX=DMA1_CH1"
            help
              Alternate on DMA1. Conflicts SPI2 default map if both use DMA.

        config BSP_SPI1_DMA_MAP_CUSTOM
            bool "Custom TX/RX unit + channel"
            help
              Configure the four int options below.
    endchoice

