            bool "TX=DMA1_CH0, RX=DMA1_CH1 (default)"

        config BSP_SPI2_DMA_MAP_DMA2
            bool "TX=DMA2_CH0, RX=DMA2_CH1"
            help
              Alternate on DMA2. May conflict SPI3 default TX (DMA2_CH0).

        config BSP_SPI2_DMA_MAP_CUSTOM
            bool "Custom TX/RX unit + channel"
    endchoice

    config BSP_SPI2_TX_DMA_UNIT
